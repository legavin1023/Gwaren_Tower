{
  "name": "dragonage-circle-alliance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve --port 8090",
    "build": "vue-cli-service build",
    "test": "node --test tests/*.test.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "worker:dev": "wrangler dev --local --config worker/wrangler.dev.toml --persist-to .wrangler/local-development --ip 127.0.0.1 --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "pages:deploy": "wrangler pages deploy dist --project-name gwaren-tower",
    "db:local": "wrangler d1 migrations apply circle-alliance-local --local --config worker/wrangler.dev.toml --persist-to .wrangler/local-development",
    "db:remote": "wrangler d1 migrations apply circle-alliance --remote --config worker/wrangler.toml",
    "dev": "node scripts/dev.mjs",
    "dev:seed": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "core-js": "^3.8.3",
    "cytoscape": "^3.33.1",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "happy-dom": "^21.0.4",
    "wrangler": "^4.0.0"
  }
}
