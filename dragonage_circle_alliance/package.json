{
  "name": "dragonage-circle-alliance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve --port 8090",
    "build": "vue-cli-service build",
    "test": "node --test tests/*.test.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "pages:deploy": "wrangler pages deploy dist --project-name gwaren-tower",
    "db:local": "wrangler d1 migrations apply circle-alliance --local --config worker/wrangler.toml",
    "db:remote": "wrangler d1 migrations apply circle-alliance --remote --config worker/wrangler.toml"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3",
    "cytoscape": "^3.33.1"
  },
  "devDependencies": {
    "@vue/cli-service": "~5.0.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@babel/core": "^7.12.16",
    "wrangler": "^4.0.0"
  }
}
